{
  "name": "@trialscale/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:isolation": "jest --selectProjects isolation --runInBand",
    "seed": "tsx src/db/seed-dev.ts",
    "seed:content": "tsx src/db/seed-content.ts",
    "seed:journey": "tsx src/db/seed-journey.ts",
    "seed:priorities": "tsx src/db/seed-priorities.ts",
    "seed:catalogo": "tsx src/db/seed-content-completo.ts",
    "seed:guias": "tsx src/db/seed-guides.ts",
    "db:apply": "tsx src/db/apply-schema.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "sequelize": "^6.37.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
