# =============================================================================
# TrialScale — Template de configuração (copie para .env e preencha)
# =============================================================================
# O .env NÃO é versionado (contém segredos). Este .example É versionado.
#   cp .env.example .env      # PowerShell: Copy-Item .env.example .env
# -----------------------------------------------------------------------------

# ── Banco de dados ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trialscale_dev
DB_NAME_TEST=trialscale_test

# Charset e fuso — não altere sem motivo (constituição §4: utf8mb4 + UTC).
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00

# ── API ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# URL do frontend (links de e-mail, ex.: redefinição de senha):
APP_URL=http://localhost:5173
# Gere um segredo com >=32 caracteres (NUNCA reutilize entre ambientes):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
